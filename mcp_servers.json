{
  "mcpServers": {
    "markitdown": {
        "command": "uvx",
        "args": [
            "markitdown-mcp"
        ]
    },
    "memory": {
      "command": "bash",
      "args": ["-c" , "mkdir -p {%workspace%}/.eduagent && npx -y @modelcontextprotocol/server-memory"],
      "env": {
        "MEMORY_FILE_PATH": "{%workspace%}/.eduagent/memory.json"
      }
    }
  }
}
